# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# Process environment variables take precedence over this file.

# AlienVault OTX: https://otx.alienvault.com
OTX_API_KEY=
OTX_BASE_URL=https://otx.alienvault.com/api/v1
OTX_TIMEOUT_SECONDS=10

# URLhaus Auth-Key: https://auth.abuse.ch
URLHAUS_AUTH_KEY=
URLHAUS_BASE_URL=https://urlhaus-api.abuse.ch/v1
URLHAUS_TIMEOUT_SECONDS=10

# Hard limit on one source, whatever it is doing
SOURCE_TIMEOUT_SECONDS=15

# Wazuh indexer, read-only account: see docs/wazuh-lab.md
WAZUH_INDEXER_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_CA_BUNDLE=
WAZUH_ALERT_INDEX=wazuh-alerts-*
WAZUH_TIMEOUT_SECONDS=10
# Most IOCs looked up for one alert
MAX_ALERT_INDICATORS=10

# Local data: cache and ATT&CK bundle. Default: ~/.ti-mcp
TI_MCP_DATA_DIR=
# 0 disables the cache
CACHE_TTL_SECONDS=3600
